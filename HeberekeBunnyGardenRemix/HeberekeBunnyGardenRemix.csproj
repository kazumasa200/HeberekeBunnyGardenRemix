<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BepInExVersion: BepInEx のメジャーバージョン。ビルド構成を "Debug_BIE6" / "Release_BIE6" にすると 6 になる。
    CLI でも指定できる: dotnet build -p:BepInExVersion=6 。省略時は 5。
    骨組みは HeberekeBunnyGardenMod の csproj から持ってきた。ゲームの DLL は Assembly\ に
    ゲームの Managed からコピーして参照する（git には入れない、配らない）。
  -->
  <PropertyGroup>
    <Configurations>Debug;Release;Debug_BIE6;Release_BIE6</Configurations>
    <BepInExVersion Condition="'$(BepInExVersion)' == '' And $(Configuration.Contains('BIE6'))">6</BepInExVersion>
    <BepInExVersion Condition="'$(BepInExVersion)' == ''">5</BepInExVersion>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>net.noeleve.HeberekeBunnyGardenRemix</AssemblyName>
    <Product>HeberekeBunnyGardenRemix</Product>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>HeberekeBunnyGardenRemix</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BepInExVersion)' == '5'">
    <DefineConstants>$(DefineConstants);BIE5</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BepInExVersion)' == '6'">
    <DefineConstants>$(DefineConstants);BIE6</DefineConstants>
    <NoWarn>$(NoWarn);BepInEx002</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(BepInExVersion)' == '5'">
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="UnityEngine.Modules" Version="6000.0.31" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup Condition="'$(BepInExVersion)' == '6'">
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Unity.Mono" Version="6.0.0-*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="UnityEngine.Modules" Version="6000.0.31" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Unity.InputSystem"><HintPath>Assembly\Unity.InputSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.Universal.Runtime"><HintPath>Assembly\Unity.RenderPipelines.Universal.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.Core.Runtime"><HintPath>Assembly\Unity.RenderPipelines.Core.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>Assembly\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UniTask"><HintPath>Assembly\UniTask.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>Assembly\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
